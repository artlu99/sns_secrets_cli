# dependencies (bun install)
# bun.lock stays tracked: it is the integrity record for the dependency graph
# compiled into dist/sns and the extension zip (Cargo.lock is tracked too).
node_modules

# output
out
dist
rs/target

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
*.tsbuildinfo

PLAN.md
PLAN?.md

# sn_secrets_cli: secrets & encrypted cache never get committed — including
# the crash-orphan temp spellings (writePrivateFileSync `.tmp-<pid>-<rand>`
# and write-file-atomic `<hash>` suffixes), whose .env.keys temps carry the
# plaintext session private key
.env.session*
.env.keys*
*.db
*.db-*
!rs/tests/fixtures/cache-v0.2.0.db
# the legacy-enc1 migration fixture is a synthetic test vector (dummy values,
# generated by a throwaway test against pre-change code), not a secret —
# without these exceptions the migration tests fail on fresh clones
!rs/tests/fixtures/legacy-enc1/.env.session
!rs/tests/fixtures/legacy-enc1/.env.keys
PLAN?.md
CLAUDE.md
rs/CLAUDE.md
AGENTS.md

