{
  "name": "sn-secrets-cli",
  "version": "0.3.0",
  "description": "Secure read-only Standard Notes companion — TypeScript CLI (tip of spear), Chrome extension, Rust portable port",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "sns": "src/index.ts"
  },
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "check": "bun check",
    "typecheck": "bun check",
    "test": "bun test src",
    "test:cli": "bun test src",
    "test:extension": "bun run --cwd extension test",
    "test:ts": "bun test src extension/lib",
    "test:rust": "cargo test --manifest-path rs/Cargo.toml",
    "test:all": "bun run test:ts && bun run test:rust",
    "build": "bun build --compile --target=bun --outfile=dist/sns --no-compile-autoload-dotenv src/index.ts",
    "build:extension": "bun run --cwd extension build",
    "build:rust": "cargo build --release --manifest-path rs/Cargo.toml",
    "check:rust": "cargo check --manifest-path rs/Cargo.toml",
    "clippy:rust": "cargo clippy --manifest-path rs/Cargo.toml --all-targets"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.65.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "commander": "^15.1.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "picocolors": "^1.1.1"
  }
}
