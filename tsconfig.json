{
  "compilerOptions": {
    // Environment setup & latest features
    // DOM libs: the extension/ workspace's UI code typechecks under this same
    // config (bun check at the root), so the web globals are part of the graph.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // extension/.output holds wxt's generated bundles — never typecheck those.
  // The .wxt/wxt.d.ts reference brings in wxt's auto-import declarations
  // (defineBackground etc.); dot-directories are skipped by ** include globs,
  // so the generated file must be named explicitly.
  "include": ["**/*", "extension/.wxt/wxt.d.ts"],
  "exclude": ["extension/.output", "extension/node_modules"]
}
